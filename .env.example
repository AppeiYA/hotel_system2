# Application Configuration

APP_ENV=development
LOG_LEVEL=debug
PORT=3333
BASE_URL=http://localhost:3333
WEBHOOK_SECRET=hotel_webhook_secret_key_123

# Database Configuration (PostgreSQL)
DATABASE_URL=postgres://postgres:postgres@db:5432/hotel?sslmode=disable
DB_HOST=db
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=hotel
DB_SSL_MODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=25
DB_CONN_MAX_LIFE=300

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_DB_URL=redis://redis:6379/0

# Startup Flags (for Docker entrypoint)
RUN_MIGRATIONS=true
RUN_SEEDS=true
